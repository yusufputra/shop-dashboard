{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shop Dashboard",
  "version": "0.1.0",
  "identifier": "com.shop.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.next": ".next",
      "../public": "public",
      "../package.json": "package.json",
      "../next.config.ts": "next.config.ts",
      "../scripts/tauri-start-next.mjs": "scripts/tauri-start-next.mjs"
    }
  }
}
